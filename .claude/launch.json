{
  "version": "0.0.1",
  "configurations": [
    {
      "name": "frontend",
      "runtimeExecutable": "npm",
      "runtimeArgs": [
        "--prefix",
        "frontend",
        "run",
        "dev"
      ],
      "port": 5173
    },
    {
      "name": "frontend-alt",
      "runtimeExecutable": "cmd",
      "runtimeArgs": [
        "/c",
        "set VITE_API_BASE_URL=http://localhost:8080&& npm --prefix frontend run dev -- --port 5174 --strictPort"
      ],
      "port": 5174
    },
    {
      "name": "backend",
      "runtimeExecutable": "mvn",
      "runtimeArgs": [
        "-f",
        "backend/pom.xml",
        "spring-boot:run"
      ],
      "port": 8080
    }
  ]
}
